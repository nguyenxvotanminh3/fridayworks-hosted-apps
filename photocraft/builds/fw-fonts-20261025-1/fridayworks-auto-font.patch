+//! Friday Works' small host-supplied font set must be ready before document validation.
+//! This is registration, not replacement: a PSD's unrelated fonts remain untouched.
+use photocraft_ui_egui::served_fonts::ServedFont;
+
+pub const FAMILIES: &[&str] = &["Be Vietnam Pro"];
+
+pub fn required(fonts: &[ServedFont]) -> Vec<ServedFont> {
+    let mut result: Vec<ServedFont> = Vec::new();
+    for font in fonts {
+        if FAMILIES.contains(&font.family.as_str()) && !result.iter().any(|f| f.file == font.file) {
+            result.push(font.clone());
+        }
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use photocraft_ui_egui::served_fonts::parse_manifest;
+
+    #[test]
+    fn preload_all_available_styles_once_without_substituting_other_families() {
+        let (fonts, _) = parse_manifest(
+            "Be Vietnam Pro | Regular | fonts/be.ttf\nBe Vietnam Pro | Bold | fonts/bold.ttf\nBe Vietnam Pro | Regular | fonts/be.ttf\nOther Family | Regular | fonts/other.ttf\n",
+        );
+        let result = required(&fonts);
+        assert_eq!(result.len(), 2);
+        assert_eq!(result[0].file, "fonts/be.ttf");
+        assert_eq!(result[1].file, "fonts/bold.ttf");
+        assert!(result.iter().all(|f| f.family == "Be Vietnam Pro"));
+    }
+
+    #[test]
+    fn invalid_or_missing_manifest_is_not_a_successful_preload() {
+        let (fonts, _) = parse_manifest("Be Vietnam Pro | Regular | https://example.com/font.ttf\n");
+        assert!(required(&fonts).is_empty());
+        assert!(required(&[]).is_empty());
+    }
+}
